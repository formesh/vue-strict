{
  "name": "vue-strict-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.17.1",
    "pnpm": ">=10.13.1"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@repo/web",
    "build": "turbo run build",
    "preview": "turbo run preview --filter=@repo/web",
    "type-check": "turbo run type-check",
    "test:unit": "turbo run test:unit --filter=@repo/web",
    "test:e2e": "turbo run test:e2e --filter=@repo/web",
    "lint": "turbo run lint",
    "format": "turbo run format --filter=@repo/web",
    "prepare": "husky",
    "commit": "cz"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "commitizen": "^4.3.1",
    "cz-git": "^1.12.0",
    "husky": "^9.1.7",
    "turbo": "^2.5.4"
  },
  "volta": {
    "node": "22.17.1"
  }
}