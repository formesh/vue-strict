{
  "name": "@repo/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "element-plus": "^2.13.7",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "npm-run-all2": "^8.0.4",
    "typescript": "~5.8.0",
    "vue-tsc": "^3.0.4"
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "dev": "run-p build:assets \"build:js --watch\" \"build:types --watch\"",
    "build:js": "tsc -p tsconfig.build.json",
    "build:types": "vue-tsc -p tsconfig.json --declaration --emitDeclarationOnly",
    "build:assets": "node ./scripts/copy-vue-assets.mjs",
    "build": "pnpm clean && pnpm build:js && pnpm build:types && pnpm build:assets",
    "type-check": "vue-tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src --deny correctness --ignore-path ../../.gitignore",
    "test:unit": "vitest run --passWithNoTests"
  }
}
