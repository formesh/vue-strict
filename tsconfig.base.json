{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "baseUrl": ".",
    "paths": {
      "@repo/utils": [
        "packages/utils/src/index.ts"
      ],
      "@repo/ai": [
        "packages/ai/src/index.ts"
      ],
      "@repo/ui": [
        "packages/ui/src/index.ts"
      ]
    }
  }
}
